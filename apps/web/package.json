    "recharts": "2.15.4",
    "tailwind-merge": "2.5.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lms/config-eslint": "workspace:*",
    "@lms/config-ts": "workspace:*",
