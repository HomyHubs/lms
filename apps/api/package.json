    "pino": "9.4.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@lms/config-eslint": "workspace:*",
    "@lms/config-ts": "workspace:*",
    "@types/node": "22.7.4",
    "@types/pg": "8.11.10",
    "eslint": "9.12.0",
