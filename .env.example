# Sao chep file nay thanh `.env` va dieu chinh khi can. KHONG commit `.env` that.

# API (apps/api)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Ket noi Postgres (khop compose.dev.yml). dbmate va apps/api deu doc bien nay.
DATABASE_URL=postgres://lms:lms@localhost:5432/lms?sslmode=disable

# ── Slice-2: OTP da kenh (dat lai mat khau) ─────────────────────────────────
# Cac sender doc secret truc tiep tu env. De trong = che do dev an toan:
#   - Email: neu thieu RESEND_API_KEY, in OTP ra log (console fallback).
#   - WhatsApp/Telegram: neu thieu cau hinh, sender nem loi ro rang khi goi.
# KHONG commit secret that — file nay chi chua gia tri gia/de trong.

# Email OTP (Resend)
RESEND_API_KEY=
RESEND_FROM=noreply@example.com

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
# Tuy chon: chat_id mac dinh khi client khong gui recipient
TELEGRAM_CHAT_ID=
